  "especialidades": [
    {
      "id": "esp-cardiologia",
      "nombre": "Cardiología",
      "codigo": "CARDIO",
      "departamento": "Consulta Médica Especializada",
      "icono": "HeartPulse",
      "descripcion": "Prevención, diagnóstico y tratamiento de enfermedades cardiovasculares, hipertensión arterial y arritmias.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "No consumir bebidas con cafeína (café, té, bebidas energizantes) ni fumar durante las 6 horas previas.",
        "Vestir ropa cómoda de dos piezas para facilitar la colocación de electrodos en tórax y extremidades.",
        "Llevar resultados previos de Electrocardiograma, Ecocardiograma, Prueba de Esfuerzo o Holter.",
        "Llevar registro claro de medicamentos antihipertensivos o anticoagulantes con sus dosis exactas."
      ]
    },
    {
      "id": "esp-medicina-interna",
      "nombre": "Medicina Interna",
      "codigo": "MED-INT",
      "departamento": "Consulta Médica Especializada",
      "icono": "Stethoscope",
      "descripcion": "Atención médica integral del adulto para diagnóstico y manejo de patologías sistémicas, crónicas y chequeos preventivos.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "Llevar fórmula médica actual y lista exacta de medicamentos con dosis y horarios habituales.",
        "Traer resultados de laboratorio de los últimos 6 meses (hemograma, glicemia, perfil lipídico, función renal).",
        "Si padece de hipertensión arterial o diabetes, traer planilla de automonitoreo de presión y glucometrías.",
        "Traer copia de electrocardiograma o ecocardiograma si le han sido practicados previamente."
      ]
    },
    {
      "id": "esp-pediatria",
      "nombre": "Pediatría",
      "codigo": "PED",
      "departamento": "Consulta Médica Especializada",
      "icono": "Baby",
      "descripcion": "Cuidado de la salud integral, crecimiento, desarrollo y nutrición de recién nacidos, niños y adolescentes.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "El menor de edad DEBE ingresar acompañado de padre, madre o representante legal con identificación original.",
        "Llevar obligatoriamente el carné físico de vacunación actualizado y curva de crecimiento y desarrollo previa.",
        "Llevar ropa cómoda de dos piezas para facilitar la valoración antropométrica y examen físico.",
        "Traer notas de egreso hospitalario si estuvo hospitalizado recientemente o notas pediátricas anteriores."
      ]
    },
    {
      "id": "esp-dermatologia",
      "nombre": "Dermatología",
      "codigo": "DERMA",
      "departamento": "Consulta Médica Especializada",
      "icono": "Sparkles",
      "descripcion": "Cuidado clínico, prevención y tratamiento de afecciones de la piel, pelo, uñas y mucosas.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "Asistir con el área a evaluar completamente limpia, sin maquillaje, polvos, bases ni cremas espesas.",
        "Si la consulta es por afecciones en las uñas, asistir sin esmalte tradicional ni acrílico.",
        "Llevar los nombres o frascos de los tratamientos tópicos, bloqueadores o cremas dermatológicas en uso.",
        "Identificar previamente los lunares o manchas que hayan cambiado de tamaño, color o forma para mostrarlos."
      ]
    },
    {
      "id": "esp-cirugia-general",
      "nombre": "Cirugía General",
      "codigo": "CIR-GRAL",
      "departamento": "Consulta Médica Especializada",
      "icono": "Scissors",
      "descripcion": "Valoración preoperatoria, postoperatoria y manejo de patologías de pared abdominal, hernias, vesícula y tejidos blandos.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "Traer ecografías, tomografías (TAC), endoscopias o radiografías previas del área a intervenir.",
        "Presentar exámenes de laboratorio prequirúrgicos recientes: hemograma, tiempos de coagulación (PT, PTT) y creatinina.",
        "Traer resumen de historia clínica anterior y órdenes médicas autorizadas.",
        "Acudir preferiblemente con un acompañante adulto si se van a programar procedimientos."
      ]
    },
    {
      "id": "esp-ortopedia",
      "nombre": "Ortopedia y Traumatología",
      "codigo": "ORTO",
      "departamento": "Consulta Médica Especializada",
      "icono": "Bone",
      "descripcion": "Diagnóstico y tratamiento de lesiones óseas, articulares, ligamentosas, patologías de columna y dolor osteomuscular.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "Traer radiografías digitales, resonancias magnéticas o ecografías articulares previas de la zona afectada.",
        "Asistir con ropa cómoda y holgada (pantaloneta o ropa deportiva) para facilitar el examen físico articular.",
        "Llevar aditamentos o soportes ortopédicos que esté utilizando (férulas, rodilleras, plantillas, muletas).",
        "Llevar lista de analgésicos o antiinflamatorios que esté tomando para el dolor."
      ]
    },
    {
      "id": "esp-otorrino",
      "nombre": "Otorrinolaringología",
      "codigo": "ORL",
      "departamento": "Consulta Médica Especializada",
      "icono": "Ear",
      "descripcion": "Atención especializada de patologías de oídos, audición, fosas nasales, senos paranasales, laringe y cuello.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "No aplicar gotas óticas ni realizar lavados caseros en los oídos durante las 24 horas previas.",
        "Si consulta por problemas de audición o vértigo, traer audiometrías, impedanciometrías o TAC de senos paranasales previos.",
        "Traer lista de medicamentos antialérgicos, descongestionantes o anticoagulantes que esté consumiendo.",
        "Si el paciente es menor de edad, debe ingresar con un acudiente mayor de edad."
      ]
    },
    {
      "id": "esp-ginecologia",
      "nombre": "Ginecología",
      "codigo": "GIN",
      "departamento": "Consulta Médica Especializada",
      "icono": "ShieldPlus",
      "descripcion": "Salud integral de la mujer, citología cérvico-vaginal, prevención ginecológica y salud reproductiva.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "No acudir durante el periodo menstrual (a menos que el motivo de consulta sea una hemorragia anormal).",
        "Abstenerse de relaciones sexuales durante las 48 horas previas si se tomará citología cérvico-vaginal.",
        "No utilizar óvulos vaginales, duchas, cremas ni tampones en los 3 días anteriores a la consulta.",
        "Tener presente la fecha exacta del primer día de su última menstruación (FUM) y llevar citologías o ecografías previas."
      ]
    },
    {
      "id": "esp-obstetricia",
      "nombre": "Obstetricia",
      "codigo": "OBS",
      "departamento": "Consulta Médica Especializada",
      "icono": "Baby",
      "descripcion": "Control prenatal especializado, vigilancia del embarazo de bajo y alto riesgo obstétrico y bienestar materno-fetal.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "Traer obligatoriamente el carné prenatal institucional o controles médicos previos.",
        "Llevar todas las ecografías obstétricas realizadas durante la gestación en orden cronológico.",
        "Presentar laboratorios de control prenatal (hemoclasificación, toxoplasma, serología, VIH, urocultivo, curva de glucosa).",
        "Asistir con ropa cómoda de dos piezas y calzado de descanso."
      ]
    },
    {
      "id": "esp-urologia",
      "nombre": "Urología",
      "codigo": "URO",
      "departamento": "Consulta Médica Especializada",
      "icono": "Activity",
      "descripcion": "Diagnóstico y tratamiento integral de patologías del aparato urinario y sistema reproductor masculino.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "Presentar orden médica de interconsulta y autorización si aplica por convenio.",
        "Si su cita incluye ecografía vesical o prostática, tome 4 vasos de agua 1 hora antes y retenga la orina para vejiga llena.",
        "Traer exámenes de laboratorio recientes: Antígeno Prostático Específico (PSA), Uroanálisis, Creatinina y ecografías previas.",
        "Llegar 15 minutos antes de la hora programada para verificación de datos y signos vitales."
      ]
    },
    {
      "id": "esp-hematologia",
      "nombre": "Hematología",
      "codigo": "HEMA",
      "departamento": "Consulta Médica Especializada",
      "icono": "Droplets",
      "descripcion": "Estudio y tratamiento especializado de anemias, coagulopatías, alteraciones en glóbulos blancos y patologías de la médula ósea.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "Traer resultados completos de hemogramas seriados y frotis de sangre periférica.",
        "Traer perfil de hierro (ferritina, hierro sérico, transferrina), vitamina B12 y ácido fólico si dispone de ellos.",
        "Llevar lista de medicamentos anticoagulantes (Warfarina, Rivaroxabán, etc.) o antiagregantes plaquetarios.",
        "Traer antecedentes de transfusiones de sangre o biopsias de médula ósea previas."
      ]
    },
    {
      "id": "esp-reumatologia",
      "nombre": "Reumatología",
      "codigo": "REUMA",
      "departamento": "Consulta Médica Especializada",
      "icono": "HeartPulse",
      "descripcion": "Diagnóstico y control de enfermedades autoinmunes y musculoesqueléticas como artritis reumatoide, lupus, fibromialgia y artrosis.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "Traer exámenes inmunológicos previos: Anticuerpos Antinucleares (ANA), Factor Reumatoideo, Anti-CCP y ENA.",
        "Traer reactantes de fase aguda recientes: Velocidad de Sedimentación Globular (VSG) y Proteína C Reactiva (PCR).",
        "Llevar radiografías articulares o ecografías osteoarticulares.",
        "Anotar la duración de la rigidez articular matutina en minutos para informar al especialista."
      ]
    },
    {
      "id": "esp-medicina-general",
      "nombre": "Consulta Medicina General",
      "codigo": "MED-GEN",
      "departamento": "Consulta Medicina General",
      "icono": "Stethoscope",
      "descripcion": "Atención médica integral de primer contacto, promoción y prevención, prescripción y formulación diagnóstica.",
      "duracionMinutos": 20,
      "activa": true,
      "recomendaciones": [
        "Presentar documento de identidad original.",
        "Llevar fórmula médica actual y carné de salud.",
        "Llegar 15 minutos antes para registro de signos vitales en enfermería.",
        "Traer exámenes de laboratorio o ecografías tomadas en el último año."
      ]
    },
    {
      "id": "esp-nutricion",
      "nombre": "Nutrición y Dietética",
      "codigo": "NUTRI",
      "departamento": "Consulta Medicina General",
      "icono": "Salad",
      "descripcion": "Asesoría nutricional clínica personalizada, valoración antropométrica, plan alimentario y manejo metabólico integral.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "Ayuno de 2 a 3 horas previas si se realizará análisis de composición corporal (bioimpedancia eléctrica).",
        "Evitar ejercicio físico extenuante y consumo de alcohol durante las 24 horas previas.",
        "Llevar registro escrito de alimentos y bebidas consumidas durante los últimos 3 días (recordatorio de 24h).",
        "Traer exámenes de sangre recientes: perfil lipídico, glucosa, insulina, ácido úrico y hemoglobina glicosilada."
      ]
    },
    {
      "id": "esp-psicologia",
      "nombre": "Psicología",
      "codigo": "PSI",
      "departamento": "Consulta Medicina General",
      "icono": "Brain",
      "descripcion": "Evaluación y acompañamiento clínico para el bienestar emocional, cognitivo y de la salud mental.",
      "duracionMinutos": 45,
      "activa": true,
      "recomendaciones": [
        "Espacio de consulta confidencial de 45 minutos. Se recomienda llegar con 10 minutos de anticipación para ambientación.",
        "Traer informes de valoraciones psicológicas, psiquiátricas o del colegio/trabajo previas si aplica.",
        "Para menores de 18 años, los primeros 15 minutos de la sesión inicial requieren la presencia del acudiente.",
        "Asistir en un estado de tranquilidad y con disposición para dialogar abiertamente con el profesional."
      ]
    },
    {
      "id": "esp-terapia-respiratoria",
      "nombre": "Terapia Respiratoria",
      "codigo": "TER-RESP",
      "departamento": "Consulta Medicina General",
      "icono": "Wind",
      "descripcion": "Sesiones de higiene bronquial, micronebulizaciones, ejercicios de expansión pulmonar y rehabilitación respiratoria.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "No ingerir comidas pesadas durante las 2 horas anteriores a la sesión terapéutica.",
        "Llevar sus inhaladores (inhalocámaras) o medicamentos broncodilatadores en uso.",
        "Asistir con ropa cómoda y holgada que facilite los movimientos torácicos y diafragmáticos.",
        "Traer orden médica indicando el número de sesiones ordenadas y diagnóstico respiratorio."
      ]
    },
    {
      "id": "esp-electrocardiograma",
      "nombre": "Electrocardiograma de Ritmo o Superficie",
      "codigo": "EKG",
      "departamento": "Diagnóstico Vascular",
      "icono": "Activity",
      "descripcion": "Registro gráfico de la actividad eléctrica del corazón en 12 derivaciones con lectura e informe cardiológico oficial.",
      "duracionMinutos": 20,
      "activa": true,
      "recomendaciones": [
        "No aplicarse cremas corporales, aceites ni lociones en el pecho, brazos o piernas el día del examen.",
        "Vestir ropa cómoda de dos piezas sin metales que facilite el acceso al tórax y extremidades.",
        "No fumar ni consumir cafeína durante las 2 horas previas a la prueba.",
        "Llegar 15 minutos antes para permitir reposo fisiológico antes del trazado."
      ]
    },
    {
      "id": "esp-ecocardiograma",
      "nombre": "Ecocardiograma Transtorácico",
      "codigo": "ECO-CARDIO",
      "departamento": "Diagnóstico Vascular",
      "icono": "HeartPulse",
      "descripcion": "Ultrasonido cardiovascular bidimensional y Doppler color para evaluar contractilidad, dimensiones de cavidades y válvulas cardíacas.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "No requiere ayuno estricto (puede ingerir alimentos livianos y sus medicamentos habituales).",
        "Asistir con ropa cómoda de dos piezas que permita descubrir el hemitórax izquierdo.",
        "Traer electrocardiogramas o ecocardiogramas previos para comparación médica.",
        "Disponer de 45 minutos para la preparación y ejecución del estudio."
      ]
    },
    {
      "id": "esp-holter",
      "nombre": "Electrocardiografía Dinámica (Holter 24 Horas)",
      "codigo": "HOLTER",
      "departamento": "Diagnóstico Vascular",
      "icono": "Activity",
      "descripcion": "Monitoreo ambulatorio continuo del ritmo cardíaco durante 24 horas continuas para detección de arritmias e isquemia silente.",
      "duracionMinutos": 20,
      "activa": true,
      "recomendaciones": [
        "Bañarse muy bien antes de asistir a la colocación del equipo, ya que NO podrá mojarse durante las 24 horas del monitoreo.",
        "Vestir blusa o camisa holgada que abra por delante con botones.",
        "Durante las 24 horas, mantener su rutina diaria normal y anotar en la bitácora hora de síntomas, sueño y medicamentos.",
        "Retornar al día siguiente a la misma hora exacta para el retiro y descarga digital de los datos."
      ]
    },
    {
      "id": "esp-mapa",
      "nombre": "Monitoreo de Presión Arterial 24 Horas (MAPA)",
      "codigo": "MAPA",
      "departamento": "Diagnóstico Vascular",
      "icono": "Activity",
      "descripcion": "Monitoreo ambulatorio automático y programado de la presión arterial durante 24 horas para diagnóstico certero de hipertensión.",
      "duracionMinutos": 20,
      "activa": true,
      "recomendaciones": [
        "Bañarse antes de la colocación del brazalete y grabador digital.",
        "Vestir ropa cómoda con manga amplia y holgada.",
        "Cuando sienta que el brazalete empieza a inflar, mantenga el brazo quieto, extendido y relajado a la altura del corazón.",
        "Registrar en la hoja de control la hora en que toma sus medicamentos antihipertensivos y los horarios de reposo nocturno."
      ]
    },
    {
      "id": "esp-proc-otorrino",
      "nombre": "Procedimientos Menores de Otorrino",
      "codigo": "PROC-ORL",
      "departamento": "Procedimientos Menores",
      "icono": "Ear",
      "descripcion": "Nasolaringoscopia con fibra óptica, toma de biopsias de fosas y laringe, lavado ótico y curaciones especializadas.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "Para nasolaringoscopia: ayuno mínimo de 2 horas previas para prevenir reflejo nauseoso.",
        "Para lavado de oídos: no aplicarse gotas óticas el día del procedimiento ni hisopos de algodón.",
        "Asistir con un acompañante adulto.",
        "Traer orden médica autorizada y exámenes diagnósticos previos."
      ]
    },
    {
      "id": "esp-proc-dermatologia",
      "nombre": "Procedimientos Menores Dermatológicos",
      "codigo": "PROC-DERMA",
      "departamento": "Procedimientos Menores",
      "icono": "Sparkles",
      "descripcion": "Biopsias cutáneas por punch/shave, onicectomía, matricectomía parcial y total, crioterapia de lesiones e infiltraciones.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "La piel de la zona a tratar debe estar completamente limpia, libre de cosméticos, cremas o aceites.",
        "Si el procedimiento es en uñas de pies o manos, asistir sin ningún tipo de esmalte y llevar calzado abierto y cómodo.",
        "Informar oportunamente al médico si consume medicamentos anticoagulantes, antiinflamatorios o aspirina.",
        "Acudir con un acompañante responsable."
      ]
    },
    {
      "id": "esp-proc-urologia",
      "nombre": "Procedimientos Menores de Urología",
      "codigo": "PROC-URO",
      "departamento": "Procedimientos Menores",
      "icono": "Activity",
      "descripcion": "Fulguración de lesiones uretrales, cistoscopia transureteral diagnóstica y dilataciones ambulatorias.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "Presentar Urocultivo con resultado negativo reciente (máximo 15 días de antigüedad).",
        "Consumir líquidos normalmente antes del procedimiento para mantener diuresis adecuada.",
        "Asistir obligatoriamente en compañía de un adulto responsable.",
        "Informar antecedentes de alergias a anestésicos locales o medicamentos."
      ]
    },
    {
      "id": "esp-proc-ortopedia",
      "nombre": "Procedimientos Menores de Ortopedia",
      "codigo": "PROC-ORTO",
      "departamento": "Procedimientos Menores",
      "icono": "Bone",
      "descripcion": "Infiltraciones articulares e intra-bursales, onicectomía y matricectomía, retiro de pines y curación de heridas complejas.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "Asistir con la zona anatómica completamente lavada con agua y jabón neutro.",
        "Vestir ropa cómoda, elástica y holgada que no comprima la articulación o extremidad intervenida.",
        "Venir acompañado de un adulto, ya que se recomienda reposo de la extremidad después del procedimiento.",
        "Traer radiografías o resonancias del área a tratar."
      ]
    },
    {
      "id": "esp-ecografia",
      "nombre": "Ecografía Especializada & Doppler Vascular",
      "codigo": "ECO",
      "departamento": "Imágenes Diagnósticas & Ecografía",
      "icono": "Activity",
      "descripcion": "Ecografía general, abdominal, pélvica, obstétrica, doppler vascular, musculoesquelética y tiroides con tecnología digital avanzada.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "Para ecografía abdominal superior o hepatobiliar: presentarse con ayuno de 6 a 8 horas (no grasas, lácteos ni gaseosas).",
        "Para ecografía pélvica, prostática o renal: tomar 4 vasos de agua 1 hora antes y retener la orina para vejiga llena.",
        "Para ecografía articular, muscular o tiroides: no requiere ayuno ni preparación especial.",
        "Traer orden médica autorizada, exámenes de laboratorio y ecografías o radiografías previas."
      ]
    },
    {
      "id": "esp-rayosx",
      "nombre": "Radiología Digital Convencional & Rayos X",
      "codigo": "RX",
      "departamento": "Imágenes Diagnósticas & Ecografía",
      "icono": "Sparkles",
      "descripcion": "Radiología convencional digital de tórax, columna, articulaciones y densitometría ósea con entrega inmediata de placas y reporte digital.",
      "duracionMinutos": 20,
      "activa": true,
      "recomendaciones": [
        "Asistir con ropa cómoda sin elementos metálicos (cremalleras, broches de metal, joyas o alambres).",
        "Pacientes mujeres en edad fértil: informar obligatoriamente al tecnólogo ante sospecha o confirmación de embarazo.",
        "Presentar orden médica indicando claramente la región anatómica y la sospecha clínica.",
        "Llegar 15 minutos antes de la hora programada para el registro en admisiones."
      ]
    },
    {
      "id": "esp-proteccion-radiologica",
      "nombre": "Protección Radiológica & Dosimetría Ocupacional",
      "codigo": "PROT-RAD",
      "departamento": "Protección Radiológica & Dosimetría",
      "icono": "Shield",
      "descripcion": "Servicio especializado en dosimetría personal ocupacional, control de calidad radiológico, blindajes y asesoría en licenciamiento.",
      "duracionMinutos": 45,
      "activa": true,
      "recomendaciones": [
        "Presentar ficha técnica y datos del equipo generador de radiación ionizante (Rayos X, Fluoroscopia, Mamografía o TAC).",
        "Para asignación o recambio de dosímetros personales OSL/TLD, presentar listado del personal ocupacionalmente expuesto (POE).",
        "Para cálculo de blindajes o levantamiento radiométrico, adjuntar planos arquitectónicos de la instalación.",
        "Presentar licencia de práctica médica o industrial anterior si aplica para trámite de renovación."
      ]
    },
    {
      "id": "esp-medicina-laboral-poe",
      "nombre": "Medicina Laboral (Personal Expuesto POE)",
      "codigo": "MED-LAB",
      "departamento": "Protección Radiológica & Dosimetría",
      "icono": "UserCheck",
      "descripcion": "Exámenes ocupacionales de ingreso, periódicos y egreso para personal expuesto a radiaciones ionizantes según normativa MinSalud.",
      "duracionMinutos": 30,
      "activa": true,
      "recomendaciones": [
        "Presentar documento de identidad original y orden de examen médico ocupacional emitida por la empresa.",
        "Traer reporte del historial dosimétrico acumulado de los últimos 12 meses.",
        "Si el protocolo incluye hemograma y recuento plaquetario, acudir en ayunas de 8 horas.",
        "Informar al médico evaluador sobre antecedentes de radioterapia o exposición médica previa."
      ]
    }
  ],
